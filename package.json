        "react-router": "^8.5.1"
    },
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint-plugin-perfectionist": "^5.13.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "oxlint": "^1.89.0",
        "prettier": "^3.9.10",
        "stylelint": "^18.0.0",
        "stylelint-config-standard": "^41.0.0",
        "stylelint-order": "^8.1.3",
        "typescript": "~7.0.2",
